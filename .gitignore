# Ignore downloaded model artifacts (any model under any deployment target)
**/model-artifacts/

# E2E run logs
**/logs/

# Bug-repro logs (any *logs* folder under bugs/)
bugs/**/*logs/

# Generated YAML (hydrated from .tmpl.yml)
**/deployment-template.yml
# ...except the committed reference scaffolding
!truss-azureml-deployment-templates/yaml/deployment-template.yml

# Self-serve (separate workflow)
self-serve/

# Temporary working files
tmp/

# Python
.venv/
__pycache__/
*.pyc
nohup.out
.DS_Store

# Notebook build/test artifacts (generated on the compute instance)
**/.build-context/
**/.model/
**/.ipynb_checkpoints/
